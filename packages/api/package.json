{
	"name": "@append/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"deploy": "wrangler deploy --env production",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest run",
		"test:preview": "vitest run --config vitest.preview.config.mts",
		"test:extension": "vitest run --config vitest.extension.config.mts",
		"typecheck": "tsc --noEmit",
		"lint:boundaries": "eslint src --no-warn-ignored",
		"cf-typegen": "wrangler types",
		"auth:generate": "pnpm dlx @better-auth/cli generate --config ./src/lib/auth/index.ts --output ./src/db/auth.schema.ts -y",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:prod": "wrangler d1 migrations apply DB --remote",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.12.0",
		"@cloudflare/workers-types": "^4.20251219.0",
		"@types/node": "^25.0.6",
		"drizzle-kit": "^0.31.8",
		"typescript": "^5.5.2",
		"vitest": "~3.2.4",
		"wrangler": "^4.59.2"
	},
	"dependencies": {
		"@ai-sdk/valibot": "^2.0.1",
		"@append/contracts": "workspace:*",
		"@hono/valibot-validator": "^0.6.1",
		"ai": "^6.0.3",
		"ai-gateway-provider": "^3.0.1",
		"better-auth": "^1.4.7",
		"better-auth-cloudflare": "^0.2.9",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.11.10",
		"valibot": "^1.2.0"
	}
}
