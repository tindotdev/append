/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "append-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-17",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	"placement": {
		"mode": "smart"
	},
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	// Note: AI Gateway is accessed via ai-gateway-provider (HTTP calls),
	// not through the Workers AI binding. No "ai" binding needed.
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// Secrets (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, BETTER_AUTH_SECRET, CF_AIG_TOKEN) are set via:
	// - Local: .dev.vars file (git-ignored)
	// - Production: `wrangler secret put <NAME>` or Doppler integration
	"vars": {
		"BETTER_AUTH_URL": "https://api.append.tindev.dev",
		// AI Gateway configuration for OpenAI routing (Step 3)
		"SUGGESTIONS_PROVIDER": "openai",
		"AI_GATEWAY_ID": "append-gateway",
		"CF_ACCOUNT_ID": "d1d83d0040d3dea7df64d58cdbebe5a9"
	},
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "append-db",
			"database_id": "db763705-f8d3-4d94-bda9-305ac66a7b3a",
			"migrations_dir": "drizzle"
		}
	],
	// Note: Secrets Store binding is in "production" env only.
	// Local dev uses OPENAI_API_KEY from .dev.vars (plain string).
	/**
	 * Environments
	 */
	"env": {
		/**
		 * Production environment
		 * - Uses Secrets Store for OPENAI_API_KEY
		 * - Deploy with: wrangler deploy -e production
		 */
		"production": {
			"name": "append-api",
			"vars": {
				"BETTER_AUTH_URL": "https://api.append.tindev.dev",
				"SUGGESTIONS_PROVIDER": "openai",
				"AI_GATEWAY_ID": "append-gateway",
				"CF_ACCOUNT_ID": "d1d83d0040d3dea7df64d58cdbebe5a9"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "append-db",
					"database_id": "db763705-f8d3-4d94-bda9-305ac66a7b3a",
					"migrations_dir": "drizzle"
				}
			],
			"secrets_store_secrets": [
				{
					"binding": "OPENAI_API_KEY",
					"store_id": "1a34ec9e145b4a4982a9880acc18e698",
					"secret_name": "append-gateway_openai_default"
				}
			]
		},
		/**
		 * Test environment (§5.2)
		 * - Enables email/password auth for testing
		 * - Uses localhost-only URL guard for safety
		 * - Uses stub provider (no Secrets Store needed)
		 */
		"test": {
			"vars": {
				"ENABLE_TEST_EMAIL_PASSWORD_AUTH": "1",
				"BETTER_AUTH_URL": "http://localhost:8787",
				"BETTER_AUTH_SECRET": "test-secret-min-32-chars-for-cookie-signing",
				"ALLOWED_EMAIL": "test-a@example.com",
				"GOOGLE_CLIENT_ID": "test-google-client-id",
				"GOOGLE_CLIENT_SECRET": "test-google-client-secret",
				"SUGGESTIONS_PROVIDER": "stub",
				"AI_GATEWAY_ID": "test-gateway"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "append-db",
					"database_id": "db763705-f8d3-4d94-bda9-305ac66a7b3a",
					"migrations_dir": "drizzle"
				}
			]
		}
	}
}
