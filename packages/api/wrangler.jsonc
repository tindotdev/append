/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "append-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-17",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	/**
	 * Rate Limiting (distributed)
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
	 *
	 * Limits ingest batches per user. Each limit() call = 1 batch.
	 * With BATCH_SIZE=200 on client, 100 batches/min = ~20k events max.
	 * This is intentionally lenient; goal is abuse prevention, not precise metering.
	 */
	"ratelimits": [
		{
			"name": "INGEST_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 100, "period": 60 }
		}
	],
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	"placement": {
		"mode": "smart"
	},
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	// Note: AI Gateway is accessed via ai-gateway-provider (HTTP calls),
	// not through the Workers AI binding. No "ai" binding needed.
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// Secrets (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, BETTER_AUTH_SECRET, CF_AIG_TOKEN, OPENAI_API_KEY) are set via:
	// - Local: .dev.vars file (synced from Doppler via `just sync-secrets`)
	// - Preview/Production: Synced from Doppler at deploy time (see .github/workflows/)
	"vars": {
		"APP_ENV": "production",
		"BETTER_AUTH_URL": "https://api.append.tindev.dev",
		// AI Gateway configuration for OpenAI routing (Step 3)
		"SUGGESTIONS_PROVIDER": "openai",
		"AI_GATEWAY_ID": "append-gateway",
		"CF_ACCOUNT_ID": "d1d83d0040d3dea7df64d58cdbebe5a9"
	},
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "append-db",
			"database_id": "db763705-f8d3-4d94-bda9-305ac66a7b3a",
			"migrations_dir": "drizzle"
		}
	],
	/**
	 * R2 Object Storage
	 * https://developers.cloudflare.com/r2/
	 */
	"r2_buckets": [
		{
			"binding": "IMPORT_FILES",
			"bucket_name": "append-imports"
		}
	],
	// Note: All secrets (including OPENAI_API_KEY) are synced from Doppler at deploy time.
	// Local dev uses .dev.vars (synced via `just sync-secrets`).
	/**
	 * Environments
	 */
	"env": {
		/**
		 * Preview environment
		 * - Used for PR preview deployments
		 * - Uses separate preview database and R2 bucket
		 * - Uses stub AI provider to avoid costs
		 * - Deploy with: wrangler deploy -e preview
		 */
		"preview": {
			"name": "append-api-preview",
			"vars": {
				"APP_ENV": "preview",
				"BETTER_AUTH_URL": "https://append-api-preview.tindotdev.workers.dev",
				"SUGGESTIONS_PROVIDER": "stub",
				"AI_GATEWAY_ID": "append-gateway-preview",
				"CF_ACCOUNT_ID": "d1d83d0040d3dea7df64d58cdbebe5a9",
				// E2E Auth: wildcard pattern allows per-PR emails like e2e-bot+pr-123@append.test
				"ALLOWED_EMAIL": "e2e-bot+*@append.test"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "append-db-preview",
					"database_id": "54c8d43b-81db-49e4-84f3-5dcf4eebc302",
					"migrations_dir": "drizzle"
				}
			],
			"r2_buckets": [
				{
					"binding": "IMPORT_FILES",
					"bucket_name": "append-imports-preview"
				}
			],
			"ratelimits": [
				{
					"name": "INGEST_RATE_LIMITER",
					"namespace_id": "1001",
					"simple": { "limit": 100, "period": 60 }
				}
			]
		},
		/**
		 * Production environment
		 * - Secrets synced from Doppler at deploy time
		 * - Deploy with: wrangler deploy -e production
		 */
		"production": {
			"name": "append-api",
			"vars": {
				"APP_ENV": "production",
				"BETTER_AUTH_URL": "https://api.append.tindev.dev",
				"SUGGESTIONS_PROVIDER": "openai",
				"AI_GATEWAY_ID": "append-gateway",
				"CF_ACCOUNT_ID": "d1d83d0040d3dea7df64d58cdbebe5a9"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "append-db",
					"database_id": "db763705-f8d3-4d94-bda9-305ac66a7b3a",
					"migrations_dir": "drizzle"
				}
			],
			"r2_buckets": [
				{
					"binding": "IMPORT_FILES",
					"bucket_name": "append-imports"
				}
			],
			"ratelimits": [
				{
					"name": "INGEST_RATE_LIMITER",
					"namespace_id": "1001",
					"simple": { "limit": 100, "period": 60 }
				}
			]
		},
		/**
		 * Test environment (§5.2)
		 * - Enables email/password auth for testing
		 * - Uses localhost-only URL guard for safety
		 * - Uses stub provider (no Secrets Store needed)
		 */
		"test": {
			"vars": {
				"APP_ENV": "test",
				"ENABLE_TEST_EMAIL_PASSWORD_AUTH": "1",
				"BETTER_AUTH_URL": "http://localhost:8787",
				"BETTER_AUTH_SECRET": "test-secret-min-32-chars-for-cookie-signing",
				"ALLOWED_EMAIL": "test-a@example.com",
				"GOOGLE_CLIENT_ID": "test-google-client-id",
				"GOOGLE_CLIENT_SECRET": "test-google-client-secret",
				"SUGGESTIONS_PROVIDER": "stub",
				"AI_GATEWAY_ID": "test-gateway",
				"CF_ACCOUNT_ID": "test-account-id"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "append-db",
					"database_id": "db763705-f8d3-4d94-bda9-305ac66a7b3a",
					"migrations_dir": "drizzle"
				}
			],
			"r2_buckets": [
				{
					"binding": "IMPORT_FILES",
					"bucket_name": "append-imports"
				}
			],
			"ratelimits": [
				{
					"name": "INGEST_RATE_LIMITER",
					"namespace_id": "1001",
					// High limit for tests to avoid cross-test interference (CF rate limiter state persists)
					"simple": { "limit": 10000, "period": 60 }
				}
			]
		}
	}
}
