# Cloudflare AI Gateway Configuration
# Copy this file to .env and fill in your values

# Your Cloudflare account ID (found in dashboard URL or API)
CF_ACCOUNT_ID=your-account-id-here

# AI Gateway ID (the gateway name you created in Cloudflare dashboard)
AI_GATEWAY_ID=append-gateway

# Cloudflare API token with AI Gateway permissions
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: AI Gateway > Read & Write
CF_AIG_TOKEN=your-cf-api-token-here

# Optional: Model to use (default: gpt-4o-mini)
# MODEL=gpt-4o-mini

# Optional: Request timeout in milliseconds (default: 30000)
# TIMEOUT_MS=30000
