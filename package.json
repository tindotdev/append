{
	"name": "append",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"setup": "pnpm install && pnpm --filter @append/api db:migrate:local",
		"dev": "pnpm -r --parallel dev",
		"dev:api": "pnpm --filter @append/api run dev",
		"dev:web": "pnpm --filter @append/web run dev",
		"dev:extension": "pnpm --filter @append/extension dev",
		"build": "pnpm -r --if-present build",
		"docs:policy": "node scripts/check-docs-policy.mjs",
		"typecheck": "pnpm -r --if-present typecheck",
		"lint": "biome lint --write .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"check:unsafe": "biome check --write --unsafe .",
		"ci:lint": "biome ci .",
		"lint:boundaries": "pnpm --filter @append/web --filter @append/api lint:boundaries",
		"test": "pnpm -r --if-present test",
		"test:api": "pnpm --filter @append/api test",
		"deploy:api": "pnpm --filter @append/api run deploy",
		"deploy:web": "pnpm --filter @append/web run deploy",
		"deploy": "pnpm deploy:api && pnpm deploy:web",
		"lab": "pnpm --filter @append/ai-gateway-lab lab",
		"prepare": "simple-git-hooks",
		"cf-typegen": "pnpm -r --if-present wrangler types"
	},
	"license": "MIT",
	"packageManager": "pnpm@10.27.0",
	"volta": {
		"node": "24.12.0"
	},
	"engines": {
		"node": ">=20",
		"pnpm": ">=9"
	},
	"pnpm": {
		"peerDependencyRules": {
			"ignoreMissing": [
				"vitest"
			],
			"allowedVersions": {
				"drizzle-orm": ">=0.41.0"
			}
		},
		"overrides": {
			"vitest": "~3.2.4",
			"@vitest/runner": "~3.2.4",
			"@vitest/snapshot": "~3.2.4"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@typescript-eslint/eslint-plugin": "^8.50.1",
		"@typescript-eslint/parser": "^8.50.1",
		"eslint": "^9.39.2",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-boundaries": "^5.3.1",
		"nano-staged": "^0.9.0",
		"simple-git-hooks": "^2.13.1"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm nano-staged && pnpm lint:boundaries && pnpm docs:policy"
	},
	"nano-staged": {
		"*.{ts,tsx,js,jsx,json,jsonc,css}": [
			"biome check --write --files-ignore-unknown=true --no-errors-on-unmatched",
			"biome format --write --files-ignore-unknown=true"
		]
	}
}
